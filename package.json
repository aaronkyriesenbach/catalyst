{
  "name": "catalyst",
  "private": true,
  "type": "module",
  "scripts": {
    "render": "bun run scripts/render.ts",
    "render-chart": "bun run scripts/render-chart.ts",
    "render-all": "bun run scripts/render-all.ts",
    "render-charts": "bun run scripts/render-charts.ts",
    "diff-renders": "bun run scripts/diff-renders.ts",
    "typecheck": "tsc --noEmit",
    "check-versions": "bun run scripts/check-versions.ts",
    "secrets": "bun run scripts/secrets.ts",
    "validate": "bun run scripts/validate.ts",
    "sync-external-certs": "bun run clusters/cluster0/tools/sync-external-certs.ts",
    "install-argo": "helm upgrade --install -n argocd --create-namespace -f ./clusters/cluster0/bootstrap/argocd-values.yaml --version 10.14.0 argocd argocd/argo-cd"
  },
  "dependencies": {
    "@kubernetes-models/argo-cd": "^4.0.0",
    "@kubernetes-models/cert-manager": "^6.0.0",
    "@kubernetes-models/external-secrets": "^2.0.0",
    "@kubernetes-models/gateway-api": "^2.0.0",
    "@kubernetes-models/traefik": "^2.0.0",
    "kubernetes-models": "5.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.11",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
