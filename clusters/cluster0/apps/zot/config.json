{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "dedupe": true,
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "24h",
    "retention": {
      "dryRun": false,
      "delay": "24h",
      "policies": [
        {
          "repositories": [
            "docker/**",
            "ghcr/**",
            "quay/**",
            "k8s/**",
            "dragonfly/**"
          ],
          "deleteReferrers": true,
          "deleteUntagged": true,
          "keepUntagged": { "pulledWithin": "720h" },
          "keepTags": [
            { "pulledWithin": "720h" },
            { "mostRecentlyPulledCount": 3 }
          ]
        }
      ]
    }
  },
  "http": { "address": "0.0.0.0", "port": "5000", "compat": ["docker2s2"] },
  "log": { "level": "info" },
  "extensions": {
    "search": { "enable": true },
    "ui": { "enable": true },
    "sync": {
      "enable": true,
      "registries": [
        {
          "urls": ["https://registry-1.docker.io"],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "10s",
          "syncTimeout": "10m",
          "manifestCheckInterval": "1h",
          "content": [{ "prefix": "**", "destination": "/docker" }]
        },
        {
          "urls": ["https://ghcr.io"],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "10s",
          "syncTimeout": "10m",
          "manifestCheckInterval": "1h",
          "content": [{ "prefix": "**", "destination": "/ghcr" }]
        },
        {
          "urls": ["https://quay.io"],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "10s",
          "syncTimeout": "10m",
          "manifestCheckInterval": "1h",
          "content": [{ "prefix": "**", "destination": "/quay" }]
        },
        {
          "urls": ["https://registry.k8s.io"],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "10s",
          "syncTimeout": "10m",
          "manifestCheckInterval": "1h",
          "content": [{ "prefix": "**", "destination": "/k8s" }]
        },
        {
          "urls": ["https://docker.dragonflydb.io"],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "10s",
          "syncTimeout": "10m",
          "manifestCheckInterval": "1h",
          "content": [{ "prefix": "**", "destination": "/dragonfly" }]
        }
      ]
    }
  }
}
